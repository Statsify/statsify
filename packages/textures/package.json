{
  "name": "@statsify/textures",
  "version": "0.0.0",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./mc-inventory": {
      "types": "./src/ui/mc-inventory.ts",
      "default": "./dist/ui/mc-inventory.js"
    },
    "./react": {
      "types": "./src/ui/react.ts",
      "default": "./dist/ui/react.js"
    },
    "./node": {
      "types": "./src/node.ts",
      "default": "./dist/node.js"
    },
    "./atlas/*": "./atlas/*",
    "./data/*": "./data/*"
  },
  "scripts": {
    "build": "swc src --config-file ../../.swcrc --out-dir dist --strip-leading-paths",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:ci": "oxlint --format=github",
    "generate": "node scripts/generate-minecraft-data.ts",
    "atlas": "node scripts/generate-atlas.ts"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.23",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.16",
    "skia-canvas": "4.0.0"
  },
  "peerDependencies": {
    "react": "^19.2.1",
    "skia-canvas": "4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "skia-canvas": {
      "optional": true
    }
  }
}
