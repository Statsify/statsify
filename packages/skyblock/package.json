{
  "name": "@statsify/skyblock",
  "version": "0.0.0",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./networth": {
      "types": "./src/networth/index.ts",
      "default": "./dist/networth/index.js"
    },
    "./icons": {
      "types": "./src/icons/index.ts",
      "default": "./dist/icons/index.js"
    },
    "./icon-key": {
      "types": "./src/icon-key.ts",
      "default": "./dist/icon-key.js"
    },
    "./display": {
      "types": "./src/display.ts",
      "default": "./dist/display.js"
    }
  },
  "scripts": {
    "build": "swc src  --config-file ../../.swcrc --out-dir dist --strip-leading-paths --copy-files",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:ci": "oxlint --format=github",
    "sync-data": "node scripts/sync-data.ts"
  },
  "dependencies": {
    "@statsify/assets": "workspace:^",
    "@statsify/math": "workspace:^",
    "@statsify/util": "workspace:^",
    "@swc/helpers": "^0.5.23",
    "prismarine-nbt": "2.8.0",
    "skia-canvas": "4.0.0",
    "skyhelper-networth": "2.11.1"
  },
  "imports": {
    "#types": {
      "types": "./src/types.ts",
      "default": "./dist/types.js"
    },
    "#raw": {
      "types": "./src/raw.ts",
      "default": "./dist/raw.js"
    },
    "#data": {
      "types": "./src/data.ts",
      "default": "./dist/data.js"
    },
    "#leveling": {
      "types": "./src/leveling.ts",
      "default": "./dist/leveling.js"
    },
    "#items": {
      "types": "./src/items.ts",
      "default": "./dist/items.js"
    },
    "#nbt": {
      "types": "./src/nbt.ts",
      "default": "./dist/nbt.js"
    },
    "#auctions": {
      "types": "./src/auctions.ts",
      "default": "./dist/auctions.js"
    },
    "#prices": {
      "types": "./src/prices.ts",
      "default": "./dist/prices.js"
    },
    "#textures": {
      "types": "./src/textures.ts",
      "default": "./dist/textures.js"
    },
    "#fixtures": "./fixtures/load.ts"
  }
}
