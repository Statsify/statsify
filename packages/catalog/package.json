{
  "name": "@statsify/catalog",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "swc src --config-file ../../.swcrc --out-dir dist --strip-leading-paths",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:ci": "oxlint --format=github"
  },
  "dependencies": {
    "@statsify/schemas": "workspace:^",
    "@statsify/util": "workspace:^",
    "@swc/helpers": "^0.5.23"
  }
}
