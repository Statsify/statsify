{
  "name": "@statsify/schemas",
  "version": "0.0.0",
  "types": "src/index.ts",
  "main": "dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./mongoose": {
      "types": "./src/definition/mongoose.ts",
      "default": "./dist/definition/mongoose.js"
    }
  },
  "scripts": {
    "build": "swc src  --config-file ../../.swcrc --out-dir dist --strip-leading-paths --copy-files",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:ci": "oxlint --format=github"
  },
  "dependencies": {
    "@statsify/math": "workspace:^",
    "@statsify/util": "workspace:^",
    "@swc/helpers": "^0.5.23",
    "luxon": "^3.5.0",
    "mongoose": "^8.5.2"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2"
  },
  "imports": {
    "#definition/*": {
      "types": "./src/definition/*.ts",
      "default": "./dist/definition/*.js"
    },
    "#game": {
      "types": "./src/game/index.ts",
      "default": "./dist/game/index.js"
    },
    "#color": {
      "types": "./src/color.ts",
      "default": "./dist/color.js"
    },
    "#prefixes": {
      "types": "./src/player/gamemodes/prefixes.ts",
      "default": "./dist/player/gamemodes/prefixes.js"
    }
  }
}
