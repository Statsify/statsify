{
  "name": "@statsify/util",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./minecraft-colors": {
      "types": "./src/minecraft-colors.ts",
      "default": "./dist/minecraft-colors.js"
    },
    "./util": {
      "types": "./src/util.ts",
      "default": "./dist/util.js"
    }
  },
  "scripts": {
    "build": "swc src  --config-file ../../.swcrc --out-dir dist --strip-leading-paths",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:ci": "oxlint --format=github",
    "fmt": "oxfmt"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.23"
  }
}
