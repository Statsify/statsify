{
  "name": "@statsify/contract",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./minified": {
      "types": "./minified.d.ts",
      "default": "./dist/contract.min.json"
    }
  },
  "scripts": {
    "build": "swc src --config-file ../../.swcrc --out-dir dist --strip-leading-paths && node scripts/minify-contract.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:ci": "oxlint --format=github"
  },
  "dependencies": {
    "@orpc/contract": "1.15.7",
    "@swc/helpers": "^0.5.23",
    "zod": "^4.1.5"
  }
}
