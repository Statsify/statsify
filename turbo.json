{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": ["pnpm-lock.yaml", "tsconfig.base.json", ".swcrc"],
  "ui": "tui",
  "tasks": {
    "build": {
      "env": ["API_URL", "API_KEY"],
      "outputs": ["dist/**", ".next/**", "pkg/**"],
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": ["^typecheck"]
    },
    "lint": {
      "outputs": [],
      "dependsOn": []
    },
    "lint:ci": {
      "outputs": [],
      "dependsOn": []
    },
    "fmt": {
      "outputs": [],
      "dependsOn": []
    }
  }
}
