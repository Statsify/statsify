{
  "name": "statsify",
  "description": "",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Statsify/statsify.git"
  },
  "scripts": {
    "build": "turbo run build --filter=!site",
    "build:watch": "turbo watch build --filter=!site",
    "typecheck": "turbo run typecheck",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "turbo run lint",
    "lint:ci": "turbo run lint:ci",
    "fmt": "turbo run fmt",
    "api": "pnpm --filter api",
    "discord-bot": "pnpm --filter discord-bot",
    "support-bot": "pnpm --filter support-bot",
    "site": "pnpm --filter site",
    "scripts": "pnpm --filter scripts",
    "verify-server": "pnpm --filter verify-server"
  },
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12",
    "@rollup/pluginutils": "^5.5.1",
    "@swc/cli": "^0.8.2",
    "@swc/core": "1.16.22",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "eslint-plugin-license-header": "^0.9.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "pm2": "^6.0.14",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2",
    "unplugin": "^3.7.0",
    "vitest": "^5.1.0"
  }
}
